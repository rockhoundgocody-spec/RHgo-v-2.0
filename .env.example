# Copy to .env.local for development. For production, set these in the
# environment of the machine that runs `npm run build` (Vite inlines VITE_*
# values at build time). Never commit real secrets - everything prefixed VITE_
# ends up in the public JavaScript bundle.

# --- Base44 backend ---------------------------------------------------------
# Required. Your Base44 app id.
VITE_BASE44_APP_ID=
# Required when the site is NOT served from *.base44.app (own server, Firebase).
# Public URL of your Base44 app, e.g. https://your-app.base44.app. Used for the
# login redirect, Google sign-in and logout; also the dev-server /api proxy.
VITE_BASE44_APP_BASE_URL=
# Optional. Pin the Base44 functions version.
VITE_BASE44_FUNCTIONS_VERSION=

# --- Google / SEO (rhgo.me) -------------------------------------------------
# Set in Base44 / hosting env, never commit secrets.
VITE_GTM_ID=GTM-XXXXXXX
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXX
VITE_GSC_VERIFICATION=

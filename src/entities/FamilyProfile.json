{
  "name": "FamilyProfile",
  "type": "object",
  "description": "Shared family unit for intergenerational collection, discovery tracking, and memory preservation.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Family name (e.g., 'The Gem Hunters', 'Rock Explorers')"
    },
    "owner_email": {
      "type": "string",
      "description": "Primary guardian email"
    },
    "member_emails": {
      "type": "array",
      "items": {"type": "string"},
      "description": "All family members (including children) who can see shared collections"
    },
    "child_emails": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Children in the family (for parental controls)"
    },
    "discovery_mode": {
      "type": "string",
      "enum": ["competitive", "collaborative", "educational", "casual"],
      "default": "collaborative",
      "description": "How the family explores together"
    },
    "child_safety_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Restrict location sharing, prevent risky site navigation"
    },
    "shared_collections": {
      "type": "array",
      "items": {"type": "string"},
      "description": "SharedCollection IDs visible to all family members"
    },
    "total_family_finds": {
      "type": "integer",
      "default": 0,
      "description": "Aggregate find count (for badges/milestones)"
    },
    "family_streak_days": {
      "type": "integer",
      "default": 0,
      "description": "Days with at least one family member active"
    },
    "archived_expeditions": {
      "type": "array",
      "items": {"type": "string"},
      "description": "MemoryCapsule IDs from past trips"
    }
  },
  "required": ["name", "owner_email"],
  "rls": {
    "create": {
      "$or": [
        {"created_by": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    },
    "read": {
      "$or": [
        {"data.owner_email": "{{user.email}}"},
        {"data.member_emails": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    },
    "update": {
      "$or": [
        {"data.owner_email": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    },
    "delete": {
      "$or": [
        {"data.owner_email": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    }
  }
}
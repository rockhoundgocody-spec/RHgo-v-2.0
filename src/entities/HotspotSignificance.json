{
  "name": "HotspotSignificance",
  "type": "object",
  "description": "Geological weighting + context for hotspots. Determines discovery importance, rarity, and educational value. One per hotspot.",
  "properties": {
    "hotspot_id": {
      "type": "string",
      "description": "Foreign key to Hotspot entity"
    },
    "scientific_importance": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 3,
      "description": "1=common site, 5=geologically significant"
    },
    "discovery_rarity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 2,
      "description": "1=easy finds common, 5=rare specimens likely"
    },
    "educational_value": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 3,
      "description": "1=minimal learning, 5=world-class teaching site"
    },
    "overall_significance_score": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Weighted average for sorting/filtering"
    },
    "geological_context": {
      "type": "string",
      "description": "Brief explanation: 'Granite pegmatite body, 1.8 billion years old. Forms during late-stage cooling of granitic intrusions.'"
    },
    "formation_process": {
      "type": "string",
      "description": "How this locality formed and why minerals concentrate here"
    },
    "notable_finds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Minerals documented at this location: ['Tourmaline', 'Beryl', 'Quartz']"
    },
    "rarity_of_finds": {
      "type": "object",
      "description": "Probability of finding specific minerals here",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "example": {
        "Quartz": 0.95,
        "Tourmaline": 0.45,
        "Beryl": 0.15,
        "Topaz": 0.02
      }
    },
    "research_references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "description": "Scientific papers documenting this locality"
    },
    "host_rock_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Granite, pegmatite, metamorphic, etc."
    },
    "terrain_difficulty": {
      "type": "string",
      "enum": ["easy", "moderate", "hard", "expert"],
      "default": "moderate",
      "description": "Physical difficulty to access/explore"
    },
    "best_season": {
      "type": "string",
      "enum": ["spring", "summer", "fall", "winter", "year-round"],
      "default": "year-round"
    },
    "accessibility_notes": {
      "type": "string",
      "description": "Wheelchair access, parking, water, shade availability"
    },
    "child_safe": {
      "type": "boolean",
      "default": true,
      "description": "Safe for families with children"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["hotspot_id"],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
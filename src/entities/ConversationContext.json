{
  "name": "ConversationContext",
  "type": "object",
  "description": "Gemma Stone voice history + session context. Enables adaptive teaching, specimen-aware coaching, memory retention.",
  "properties": {
    "owner_email": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "Unique session identifier for this conversation"
    },
    "active_specimen_id": {
      "type": "string",
      "description": "Current specimen being discussed (if scanning)"
    },
    "active_hotspot_id": {
      "type": "string",
      "description": "Current location being explored (if mapping)"
    },
    "conversation_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {"type": "string", "format": "date-time"},
          "role": {"type": "string", "enum": ["user", "gemma"]},
          "text": {"type": "string"},
          "intent": {"type": "string"},
          "context_tags": {"type": "array", "items": {"type": "string"}}
        }
      },
      "description": "Chat history for this session"
    },
    "teaching_style": {
      "type": "string",
      "enum": ["detailed", "concise", "playful", "scientific", "practical"],
      "default": "balanced",
      "description": "Adaptive to user preferences"
    },
    "geological_facts_covered": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Topics Gemma has already explained (avoid repetition)"
    },
    "user_questions_patterns": {
      "type": "object",
      "description": "Patterns in what user asks (micro/macro, safety, rarity, etc)"
    },
    "recommended_next_steps": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Gemma's coaching suggestions based on finds/questions"
    },
    "confidence_boosters": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Encouraging statements Gemma has made"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_interaction": {
      "type": "string",
      "format": "date-time"
    },
    "session_duration_minutes": {
      "type": "integer"
    }
  },
  "required": ["owner_email", "session_id"],
  "rls": {
    "create": {
      "$or": [
        {"created_by": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    },
    "read": {
      "$or": [
        {"data.owner_email": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    },
    "update": {
      "$or": [
        {"data.owner_email": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    }
  }
}
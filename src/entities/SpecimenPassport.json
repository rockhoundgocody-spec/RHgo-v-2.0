{
  "name": "SpecimenPassport",
  "type": "object",
  "description": "Audit trail + provenance tracking for specimens. One per specimen. Records all identification corrections, confidence evolution, and metadata snapshots.",
  "properties": {
    "specimen_id": {
      "type": "string",
      "description": "Foreign key to Specimen entity"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the rockhound who owns the specimen"
    },
    "action_log": {
      "type": "array",
      "description": "Append-only log of all actions taken on this specimen",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string",
            "enum": ["classified", "corrected", "verified", "tested", "appraised", "shared"],
            "description": "Type of action performed"
          },
          "classification_before": {
            "type": "string",
            "description": "Previous classification (if correction)"
          },
          "classification_after": {
            "type": "string",
            "description": "New classification (if correction)"
          },
          "confidence_before": {
            "type": "number",
            "description": "Confidence score before (0-1)"
          },
          "confidence_after": {
            "type": "number",
            "description": "Confidence score after (0-1)"
          },
          "actor": {
            "type": "string",
            "description": "User email or 'system' (for AI classifications)"
          },
          "notes": {
            "type": "string",
            "description": "Why the correction was made"
          },
          "ai_reasoning": {
            "type": "object",
            "description": "AI reasoning for classification (if AI action)"
          }
        },
        "required": ["timestamp", "action", "actor"]
      }
    },
    "confidence_history": {
      "type": "array",
      "description": "Time-series of confidence scores as identification refined",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "classification": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason_for_change": {
            "type": "string"
          }
        }
      }
    },
    "metadata_snapshots": {
      "type": "array",
      "description": "Snapshots of specimen metadata at key moments",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "image_count": {
            "type": "integer"
          },
          "location": {
            "type": "string"
          },
          "ai_reasoning": {
            "type": "object"
          },
          "verification_tests_performed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "total_corrections": {
      "type": "integer",
      "default": 0,
      "description": "Count of user corrections (AI confidence calibration)"
    },
    "final_confidence": {
      "type": "number",
      "description": "Current best-estimate confidence (0-1)"
    }
  },
  "required": ["specimen_id", "owner_email"],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "MemoryCapsule",
  "type": "object",
  "description": "Temporal snapshot of a field expedition: location, date, finds, companions, weather, mood. A family memory artifact.",
  "properties": {
    "owner_email": {
      "type": "string"
    },
    "family_profile_id": {
      "type": "string",
      "description": "If part of family trip, link to FamilyProfile"
    },
    "expedition_name": {
      "type": "string",
      "description": "e.g., 'Summer in Colorado', 'Mom & Lily's First Rock Hunt'"
    },
    "expedition_date": {
      "type": "string",
      "format": "date",
      "description": "When the expedition happened"
    },
    "location_name": {
      "type": "string",
      "description": "Where they went (e.g., 'Manitou Incline, Colorado Springs')"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "specimen_ids_found": {
      "type": "array",
      "items": {"type": "string"},
      "description": "All specimens logged on this expedition"
    },
    "total_finds": {
      "type": "integer",
      "default": 0
    },
    "companion_emails": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Who was there (for intergenerational memory)"
    },
    "weather_snapshot": {
      "type": "object",
      "properties": {
        "temperature_f": {"type": "number"},
        "condition": {"type": "string"},
        "humidity": {"type": "number"}
      },
      "description": "Environmental context"
    },
    "mood_snapshot": {
      "type": "string",
      "enum": ["excited", "adventurous", "peaceful", "playful", "curious", "satisfied"],
      "description": "Overall vibe of the expedition"
    },
    "story": {
      "type": "string",
      "maxLength": 2000,
      "description": "Journal entry from this trip"
    },
    "highlights": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Photo URLs of best moments"
    },
    "difficulty_level": {
      "type": "string",
      "enum": ["easy", "moderate", "challenging"],
      "description": "How hard was the trip"
    },
    "next_goals": {
      "type": "string",
      "maxLength": 500,
      "description": "What they want to find next time"
    },
    "sealed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the capsule was 'sealed' (completed)"
    }
  },
  "required": ["owner_email", "expedition_name", "expedition_date"],
  "rls": {
    "create": {
      "$or": [
        {"created_by": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    },
    "read": {
      "$or": [
        {"data.owner_email": "{{user.email}}"},
        {"data.companion_emails": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    },
    "update": {
      "$or": [
        {"data.owner_email": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    }
  }
}
{
  "name": "GeologicalContext",
  "type": "object",
  "description": "Geological formation data: host rock, epoch, rarity geology, educational value. Singleton per mineral type + location region.",
  "properties": {
    "mineral_name": {
      "type": "string",
      "description": "e.g. 'Amethyst', 'Magnetite'"
    },
    "region": {
      "type": "string",
      "description": "Geospatial region (US state, country, or geological province)"
    },
    "host_rock": {
      "type": "string",
      "enum": ["granite", "basalt", "limestone", "sandstone", "schist", "marble", "hydrothermal", "pegmatite", "other"],
      "description": "Primary host rock type"
    },
    "geological_period": {
      "type": "string",
      "enum": ["archean", "proterozoic", "paleozoic", "mesozoic", "cenozoic", "recent"],
      "description": "Age bracket of formation"
    },
    "formation_process": {
      "type": "string",
      "enum": ["igneous", "sedimentary", "metamorphic", "hydrothermal"],
      "description": "How the mineral formed"
    },
    "rarity_geology": {
      "type": "string",
      "enum": ["extremely-rare", "very-rare", "rare", "uncommon", "common"],
      "description": "Geological rarity (independent of specimens found)"
    },
    "educational_summary": {
      "type": "string",
      "maxLength": 1000,
      "description": "Why this mineral is scientifically interesting in this region"
    },
    "verification_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test": {"type": "string"},
          "method": {"type": "string"},
          "expected_result": {"type": "string"}
        }
      },
      "description": "Field tests recommended for this mineral in this geology"
    },
    "lookalike_minerals": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Common false positives in this region"
    },
    "safety_hazards": {
      "type": "array",
      "items": {"type": "string"},
      "description": "E.g., radioactivity, asbestos, toxic dust"
    },
    "sourced_from": {
      "type": "string",
      "description": "Data source (USGS, MinDat, field experience)"
    }
  },
  "required": ["mineral_name", "region"],
  "rls": {
    "create": {
      "user_condition": {"role": "admin"}
    },
    "read": {},
    "update": {
      "user_condition": {"role": "admin"}
    },
    "delete": {
      "user_condition": {"role": "admin"}
    }
  }
}
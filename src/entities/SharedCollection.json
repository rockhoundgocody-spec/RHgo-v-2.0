{
  "name": "SharedCollection",
  "type": "object",
  "description": "Curated, shared collection of specimens visible to family, friends, or the RockHound community.",
  "properties": {
    "creator_email": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Collection name (e.g., 'Colorado Trip 2025', 'Amethyst Collection')"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "specimen_ids": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Specimens included in this collection"
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "family-only", "friends", "community", "public"],
      "default": "family-only"
    },
    "theme": {
      "type": "string",
      "enum": ["geological-period", "location", "rarity", "color", "mineral-family", "custom"],
      "description": "How the collection is organized"
    },
    "cover_image_url": {
      "type": "string",
      "description": "Hero image for the collection"
    },
    "featured_specimen_id": {
      "type": "string",
      "description": "Flagship specimen for the collection"
    },
    "story": {
      "type": "string",
      "maxLength": 2000,
      "description": "Narrative about this collection (where discovered, why meaningful)"
    },
    "total_value_estimate": {
      "type": "string",
      "description": "Combined rarity/value estimate (for engagement tracking)"
    },
    "shared_with": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Email addresses or family_profile IDs collection is shared with"
    },
    "allow_commenting": {
      "type": "boolean",
      "default": false,
      "description": "Can viewers leave comments/feedback"
    },
    "view_count": {
      "type": "integer",
      "default": 0
    }
  },
  "required": ["creator_email", "title", "specimen_ids"],
  "rls": {
    "create": {
      "$or": [
        {"created_by": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    },
    "read": {
      "$or": [
        {"data.creator_email": "{{user.email}}"},
        {"data.shared_with": "{{user.email}}"},
        {"data.visibility": {"$in": ["public", "community"]}}
      ]
    },
    "update": {
      "$or": [
        {"data.creator_email": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    },
    "delete": {
      "$or": [
        {"data.creator_email": "{{user.email}}"},
        {"user_condition": {"role": "admin"}}
      ]
    }
  }
}
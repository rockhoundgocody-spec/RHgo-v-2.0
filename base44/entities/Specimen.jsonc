{
  "name": "Specimen",
  "type": "object",
  "properties": {
    "mineral_name": {
      "type": "string"
    },
    "common_name": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "found_at": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "found_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "ai_confidence": {
      "type": "number"
    },
    "ai_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "legendary"
      ],
      "default": "common"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "weather": {
      "type": "object",
      "description": "Weather snapshot at time/place of finding",
      "properties": {
        "temperature_f": {
          "type": "number"
        },
        "condition": {
          "type": "string"
        },
        "humidity": {
          "type": "number"
        },
        "wind_mph": {
          "type": "number"
        },
        "fetched_at": {
          "type": "string"
        }
      }
    },
    "lunar_phase": {
      "type": "object",
      "description": "Lunar phase at time of finding",
      "properties": {
        "phase_name": {
          "type": "string"
        },
        "illumination": {
          "type": "number"
        },
        "phase_value": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "mineral_name"
  ]
}
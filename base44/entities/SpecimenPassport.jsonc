{
  "name": "SpecimenPassport",
  "type": "object",
  "description": "Append-only provenance + AI explainability record for a Specimen. One row per identification or verification event \u2014 together they form the specimen's life history.",
  "properties": {
    "specimen_id": {
      "type": "string",
      "description": "ID of the parent Specimen this passport entry belongs to"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the rockhound who owns this specimen"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "identification",
        "reidentification",
        "verification",
        "correction",
        "appraisal",
        "transfer"
      ],
      "default": "identification",
      "description": "What kind of life event this passport row records"
    },
    "primary_name": {
      "type": "string",
      "description": "Best-guess mineral name at the time of this event"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Calibrated confidence (0..1) for primary_name"
    },
    "candidates": {
      "type": "array",
      "description": "Ranked alternative identifications considered",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "rarity": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "reasoning": {
      "type": "string",
      "maxLength": 2000,
      "description": "Plain-language explanation of WHY the AI chose primary_name (color, luster, habit, fracture, locality cues observed)"
    },
    "observed_features": {
      "type": "array",
      "description": "Discrete visual features the AI extracted from the image(s)",
      "items": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string",
            "description": "e.g. 'color', 'luster', 'crystal_habit', 'streak'"
          },
          "value": {
            "type": "string",
            "description": "e.g. 'pale violet', 'vitreous', 'hexagonal prism'"
          }
        }
      }
    },
    "lookalikes": {
      "type": "array",
      "description": "Common minerals that resemble primary_name and how to tell them apart",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "differentiator": {
            "type": "string"
          }
        }
      }
    },
    "verification_tests": {
      "type": "array",
      "description": "Hands-on tests the user can run to confirm or refute primary_name",
      "items": {
        "type": "object",
        "properties": {
          "test": {
            "type": "string",
            "description": "e.g. 'streak', 'hardness', 'magnetism', 'acid'"
          },
          "expected": {
            "type": "string",
            "description": "What primary_name should do"
          },
          "performed": {
            "type": "boolean",
            "default": false
          },
          "result": {
            "type": "string",
            "description": "What the user actually observed"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "image_quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "How usable the input image(s) were \u2014 0 blurry, 1 ideal"
    },
    "geological_plausibility": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "How plausible primary_name is given lat/lng + known regional geology"
    },
    "model_version": {
      "type": "string",
      "description": "MLModel.version or 'gemini-flash' that produced this entry"
    },
    "input_image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Image URLs analyzed for this event"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Free-form notes from the user or system about this event"
    }
  },
  "required": [
    "specimen_id",
    "event_type",
    "primary_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "PlayerProfile",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string"
    },
    "total_xp": {
      "type": "integer",
      "default": 0
    },
    "level": {
      "type": "integer",
      "default": 1
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "avatar_url": {
      "type": "string"
    },
    "streak_days": {
      "type": "integer",
      "default": 0
    },
    "last_login": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "owner_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
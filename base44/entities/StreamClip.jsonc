{
  "name": "StreamClip",
  "type": "object",
  "description": "A 15-second highlight clip exported from a live stream, formatted for TikTok/Reels/Shorts sharing. Generated by the host during a broadcast when a notable find or moment happens.",
  "properties": {
    "stream_id": {
      "type": "string",
      "description": "LiveStream this clip was exported from"
    },
    "owner_email": {
      "type": "string"
    },
    "clip_url": {
      "type": "string",
      "description": "URL of the exported clip video file"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Cover frame for the clip"
    },
    "mineral_name": {
      "type": "string",
      "description": "Mineral identified in this clip, if any"
    },
    "title": {
      "type": "string",
      "description": "Short title/caption for the clip"
    },
    "duration_seconds": {
      "type": "integer",
      "default": 15,
      "description": "Clip length in seconds \u2014 15s for TikTok/Reels"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "9:16",
        "1:1",
        "16:9"
      ],
      "default": "9:16",
      "description": "Vertical 9:16 for TikTok/Reels, square 1:1 for Instagram, landscape 16:9 for YouTube"
    },
    "share_count": {
      "type": "integer",
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-form description of this stream clip (up to 1000 characters)"
    }
  },
  "required": [
    "stream_id",
    "owner_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
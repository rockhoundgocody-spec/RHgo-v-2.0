{
  "name": "Daily Stats Sheet Sync",
  "description": "Writes anonymized app stats (total users, specimens, hotspots, rarity distribution, top minerals) to the RockHound-GO Daily Stats Google Sheet every night.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_stats_sheet_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncStatsToSheets",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
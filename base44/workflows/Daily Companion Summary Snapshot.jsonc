{
  "name": "Daily Companion Summary Snapshot",
  "description": "Snapshots every user's companion mood, level, XP, and streak into CompanionLog at end of day. Powers the in-app Daily Summary view.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 4 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_companion_summary_snapshot",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recordDailyCompanionLog",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}